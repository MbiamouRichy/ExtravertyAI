// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 📦 ENUMS EXISTANTS ET NOUVEAUX
// ------------------------------------------------------

enum InstanceStatus {
  disconnected
  connecting
  qr_ready     // NOUVEAU: En attente de scan du QR Code
  connected
}

enum ProjectStatus {
  trialing   // Phase de test par le client (Statut par défaut)
  active     // Abonnement payé, en production
  paused     // Mis en pause temporairement
  inactive   // Abonnement annulé / non payé
}

enum Role {
  USER
  ADMIN
  OWNER
}

enum Theme {
  light
  dark
  system
}

enum Plan {
  starter
  business
  pro
}

// --- NOUVEAUX ENUMS (CRM & WHATSAPP) ---

enum SenderType {
  CLIENT
  BOT
  AGENT
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
  OTHER
}

// ------------------------------------------------------
// 🏢 MODÈLE PROJET (Le cœur de la facturation & Configuration)
// ------------------------------------------------------
model Project {
  id                   String         @id @default(cuid())
  name                 String
  numero               String        
  status               ProjectStatus  @default(trialing)
  
  // --- Instances API WhatsApp (Evolution API) ---
  instanceName         String         @unique
  instanceToken        String?        @unique // SÉCURITÉ: Authentifie les webhooks provenant d'Evolution API
  instanceStatus       InstanceStatus @default(disconnected)
  
  plan                 Plan           @default(starter)
  messageCount         Int            @default(0)
  allMessagesCount     Int            @default(0)

  // --- 💳 FACTURATION STRIPE ---
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?        @unique
  stripePriceId        String?
  stripeCurrentPeriodEnd DateTime?

  // --- 👥 RELATIONS CRM ---
  members              ProjectMembership[]
  contacts             Contact[]      // Les prospects WhatsApp du projet
  messages             Message[]      // Tous les messages liés à ce projet
  invitations          Invitation[]   // Les invitations au projet
  // Dates
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  expiredAt            DateTime?    
  
  @@map("project")
}

// ------------------------------------------------------
// 📞 CRM : CONTACTS (Les prospects WhatsApp)
// ------------------------------------------------------
model Contact {
  id          String    @id @default(cuid())
  phone       String    // Numéro classique (ex: 24107123456)
  
  // --- Identifiants Evolution API ---
  remoteJid   String    // Identifiant exact WhatsApp (ex: 24107123456@s.whatsapp.net)
  pushName    String?   // Pseudo public WhatsApp du prospect
  
  name        String?   // Nom assigné par l'agent ou l'IA dans l'interface
  aiActive    Boolean   @default(true) // Handover: False si un agent a pris le relais
  
  // --- Relations ---
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    Message[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // SÉCURITÉ & PERF: Un contact (JID) est unique par projet. Indexé pour recherche rapide.
  @@unique([projectId, remoteJid])
  @@index([projectId])
  @@index([projectId, updatedAt, id])
  @@map("contact")
}

// ------------------------------------------------------
// 💬 CRM : MESSAGES (Historique des conversations)
// ------------------------------------------------------
model Message {
  id           String        @id @default(cuid())
  
  // --- Traçabilité Evolution API ---
  evolutionId  String?       @unique // ID officiel 'key.id' renvoyé par Evolution API (crucial pour les accusés de lecture)
  fromMe       Boolean       @default(false)
  
  // --- Contenu ---
  content      String        @db.Text
  type         MessageType   @default(TEXT)
  mediaUrl     String?       // URL du fichier si c'est un média
  
  senderType   SenderType
  status       MessageStatus @default(PENDING)
  errorMessage String?       @db.Text // Stocke le log d'erreur si status == FAILED
  source      String?  @default("unknown") // "android", "ios", "ai"
  // --- Relations ---
  contactId    String
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // SÉCURITÉ: Si l'agent est supprimé, on garde le message (SetNull)
  agentId      String?
  agent        User?         @relation(fields: [agentId], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // INDEXATION PRO-GRADE : Vitale pour charger le chat sans latence
  @@index([projectId])
  @@index([contactId, createdAt(sort: Desc)])
  @@index([evolutionId])
  @@index([projectId, contactId, createdAt, id])
  @@map("message")
}

// ------------------------------------------------------
// 🔗 TABLE DE LIAISON (Gestion des accès et de l'équipe)
// ------------------------------------------------------
model ProjectMembership {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("project_membership")
}

// ------------------------------------------------------
// 👤 UTILISATEURS & AUTHENTIFICATION (Better Auth)
// ------------------------------------------------------
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  theme         Theme     @default(system)
  
  globalRole    Role      @default(USER) 

  memberships   ProjectMembership[]
  messagesSent  Message[] // Historique des messages envoyés manuellement par cet utilisateur
  lastActiveAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invitations Invitation[]
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  projectId String
  role      Role     @default(USER)
  token     String   @unique
  
  inviterId String
  inviter   User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  // Un email ne peut avoir qu'une seule invitation active par projet
  @@unique([email, projectId]) 
  @@index([token])
  @@map("invitation")
}