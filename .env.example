# Local: copy to .env. Workers: copy to .env.production on their server.
# Vercel: enter values in project Environment Variables. Never commit credentials.
# See docs/vercel-preproduction.md for the complete setup.
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/extraverty
# Authentication: use the same stable HTTPS origin for all three URLs on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:3000
BETTER_AUTH_SECRET=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional social provider; leave disabled in the provider console until configured.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Required by the current profile-upload module, including at build time.
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Use an HTTPS endpoint reachable from Vercel (not a Docker service name).
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
# Exact model slug enabled in your OpenRouter account.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Instinct uses the same API key with Decisions models independently of OPENROUTER_MODEL:
# typesafe/jev-1.13, or openai/gpt-6-luna-decisions when context exceeds Jev's budget.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PLAN_ID=
STRIPE_PRO_PLAN_ID=
STRIPE_BUSINESS_PLAN_ID=
# Proposed launch quotas, configurable per paid plan.
MESSAGE_LIMIT_STARTER=4000
MESSAGE_LIMIT_PRO=10000
MESSAGE_LIMIT_BUSINESS=25000

# Optional: verified Resend sender for billing notifications.
BILLING_EMAIL_FROM=ExtravertyAI <notification@extravertyai.com>
