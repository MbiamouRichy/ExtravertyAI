# Copier en `.env` à côté de compose.yaml (chmod 600). Ne jamais commiter `.env`.
# Générer les deux secrets avec : openssl rand -hex 32
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=
# Domaine public, sans https:// (enregistrement DNS A vers l’IP du VPS).
GLITCHTIP_HOST=errors.extravertyai.com
GLITCHTIP_FROM_EMAIL=GlitchTip <noreply@extravertyai.com>
# Alertes par e-mail via le SMTP de Resend (clé API Resend comme mot de passe) :
# smtp+ssl://resend:CLE_RESEND@smtp.resend.com:465
GLITCHTIP_EMAIL_URL=
# Mettre à true le temps de créer le premier compte, puis remettre à false.
GLITCHTIP_OPEN_REGISTRATION=false
