# Copier en /etc/extravertyai/backup.env (root, chmod 600). Jamais dans Git.
# Cloudflare R2 → R2 Object Storage → Manage API tokens : jeton « Object Read & Write »
# limité au seul bucket de sauvegarde.
R2_BUCKET=extravertyai-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# https://<ID_DU_COMPTE>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_ACL=private
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
# Moniteur « Heartbeat » de GlitchTip (Uptime Monitors) : prévient si aucune
# sauvegarde n’a réussi depuis 26 heures. Facultatif mais recommandé.
BACKUP_HEARTBEAT_URL=
